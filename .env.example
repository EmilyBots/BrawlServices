# ─────────────────────────────────────────────
#  Brawl Services™ Bot – Environment Variables
# ─────────────────────────────────────────────

# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# PostgreSQL (Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Channel IDs
TICKET_CATEGORY_ID=
ORDER_LOG_CHANNEL_ID=
VOUCH_CHANNEL_ID=
STAFF_LOG_CHANNEL_ID=
PAYMENT_LOG_CHANNEL_ID=

# Role IDs
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
BOOSTER_ROLE_ID=
CUSTOMER_ROLE_ID=
VERIFIED_ROLE_ID=

# Custom Emoji IDs (format: name:id)
EMOJI_BRONZE1=bronze1:000000000000000000
EMOJI_BRONZE2=bronze2:000000000000000000
EMOJI_BRONZE3=bronze3:000000000000000000
EMOJI_SILVER1=silver1:000000000000000000
EMOJI_SILVER2=silver2:000000000000000000
EMOJI_SILVER3=silver3:000000000000000000
EMOJI_GOLD1=gold1:000000000000000000
EMOJI_GOLD2=gold2:000000000000000000
EMOJI_GOLD3=gold3:000000000000000000
EMOJI_DIAMOND1=diamond1:000000000000000000
EMOJI_DIAMOND2=diamond2:000000000000000000
EMOJI_DIAMOND3=diamond3:000000000000000000
EMOJI_MYTHIC1=mythic1:000000000000000000
EMOJI_MYTHIC2=mythic2:000000000000000000
EMOJI_MYTHIC3=mythic3:000000000000000000
EMOJI_LEGENDARY1=legendary1:000000000000000000
EMOJI_LEGENDARY2=legendary2:000000000000000000
EMOJI_LEGENDARY3=legendary3:000000000000000000
EMOJI_MASTERS1=masters1:000000000000000000
EMOJI_MASTERS2=masters2:000000000000000000
EMOJI_MASTERS3=masters3:000000000000000000
EMOJI_PRO1=pro1:000000000000000000
EMOJI_PRESTIGE1=prestige1:000000000000000000
EMOJI_PRESTIGE2=prestige2:000000000000000000
EMOJI_PRESTIGE3=prestige3:000000000000000000
EMOJI_PAYPAL=paypal:000000000000000000

# Payment
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox = test mode, live = real money
PAYPAL_MODE=sandbox

# Web – Your Railway public URL (used for PayPal return/cancel URLs)
# Generate it in Railway: your service → Settings → Domains → Generate Domain
# Example: https://brawl-services-bot-production-xxxx.up.railway.app
PORT=3000
WEB_URL=https://your-railway-app.up.railway.app
